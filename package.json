{
  "name": "tgas-local",
  "version": "2.0.0",
  "description": "Typescript support for running and testing GAS projects locally.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "scripts": {
    "clean": "rimraf --glob ./lib",
    "build": "pnpm run clean && tsc -p ./tsconfig.json",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "files": [
    "lib/**/*"
  ],
  "keywords": [
    "Google Apps Script",
    "gas",
    "typescript",
    "gas-local",
    "googleappsscript"
  ],
  "author": "Seth Aker <saker132@gmail.com> (https://github.com/seth-aker)",
  "repository": {
    "url": "https://github.com/seth-aker/tgas-local"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "esbuild": "^0.28.2",
    "glob": "^14.0.6",
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "@types/google-apps-script": "^2.0.15"
  },
  "devDependencies": {
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^24.19.2",
    "memfs": "^4.80.1",
    "rimraf": "^6.1.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
